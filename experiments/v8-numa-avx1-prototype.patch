+enum pdl_numa_policy {
+    PDL_NUMA_NONE = 0,
+    PDL_NUMA_INTERLEAVE01,
+    PDL_NUMA_BIND0,
+    PDL_NUMA_BIND1,
+    PDL_NUMA_PREFERRED0,
+    PDL_NUMA_PREFERRED1,
+};
+
+static enum pdl_numa_policy pdl_numa_policy_from_string(const char * text) {
+    if (text == NULL || text[0] == '\0' || strcmp(text, "none") == 0 || strcmp(text, "inherit") == 0) {
+        return PDL_NUMA_NONE;
+    }
+    if (strcmp(text, "interleave") == 0 || strcmp(text, "interleave01") == 0 || strcmp(text, "0,1") == 0) {
+        return PDL_NUMA_INTERLEAVE01;
+    }
+    if (strcmp(text, "bind0") == 0 || strcmp(text, "node0") == 0) {
+        return PDL_NUMA_BIND0;
+    }
+    if (strcmp(text, "bind1") == 0 || strcmp(text, "node1") == 0) {
+        return PDL_NUMA_BIND1;
+    }
+    if (strcmp(text, "preferred0") == 0) {
+        return PDL_NUMA_PREFERRED0;
+    }
+    if (strcmp(text, "preferred1") == 0) {
+        return PDL_NUMA_PREFERRED1;
+    }
+    GGML_LOG_WARN("pdl-numa: unknown policy '%s'; using inherit\n", text);
+    return PDL_NUMA_NONE;
+}
+
+static const char * pdl_numa_policy_name(enum pdl_numa_policy policy) {
+    switch (policy) {
+        case PDL_NUMA_INTERLEAVE01: return "interleave01";
+        case PDL_NUMA_BIND0:        return "bind0";
+        case PDL_NUMA_BIND1:        return "bind1";
+        case PDL_NUMA_PREFERRED0:   return "preferred0";
+        case PDL_NUMA_PREFERRED1:   return "preferred1";
+        case PDL_NUMA_NONE:         return "inherit";
+    }
+    return "inherit";
+}
+
+static bool pdl_numa_apply(void * data, size_t size, enum pdl_numa_policy policy) {
+#if defined(__linux__) && defined(SYS_mbind)
+    if (policy == PDL_NUMA_NONE || data == NULL || size == 0) {
+        return true;
+    }
+
+    unsigned long mask = 0;
+    int mode = MPOL_DEFAULT;
+    switch (policy) {
+        case PDL_NUMA_INTERLEAVE01: mask = 0x3UL; mode = MPOL_INTERLEAVE; break;
+        case PDL_NUMA_BIND0:        mask = 0x1UL; mode = MPOL_BIND;       break;
+        case PDL_NUMA_BIND1:        mask = 0x2UL; mode = MPOL_BIND;       break;
+        case PDL_NUMA_PREFERRED0:   mask = 0x1UL; mode = MPOL_PREFERRED;  break;
+        case PDL_NUMA_PREFERRED1:   mask = 0x2UL; mode = MPOL_PREFERRED;  break;
+        case PDL_NUMA_NONE: return true;
+    }
+
+    const unsigned long maxnode = sizeof(mask) * 8UL;
+    const long rc = syscall(SYS_mbind, data, size, mode | MPOL_F_STATIC_NODES, &mask, maxnode, 0UL);
+    if (rc != 0) {
+        GGML_LOG_WARN("pdl-numa: mbind policy=%s size=%zu failed: %s\n",
+                pdl_numa_policy_name(policy), size, strerror(errno));
+        return false;
+    }
+    return true;
+#else
+    GGML_UNUSED(data);
+    GGML_UNUSED(size);
+    GGML_UNUSED(policy);
+    return false;
+#endif
+}
+
+static void * pdl_numa_aligned_malloc(size_t size, enum pdl_numa_policy policy) {
+    if (policy == PDL_NUMA_NONE) {
+        return ggml_aligned_malloc(size);
+    }
+#if defined(__linux__)
+    const long page_size_l = sysconf(_SC_PAGESIZE);
+    const size_t page_size = page_size_l > 0 ? (size_t) page_size_l : (size_t) 4096;
+    const size_t alloc_size = ((size + page_size - 1) / page_size) * page_size;
+    void * data = NULL;
+    if (posix_memalign(&data, page_size, alloc_size) != 0) {
+        return NULL;
+    }
+    if (!pdl_numa_apply(data, alloc_size, policy)) {
+        const char * strict = getenv("PDL_NUMA_STRICT");
+        if (strict && atoi(strict) != 0) {
+            free(data);
+            return NULL;
+        }
+    }
+    return data;
+#else
+    GGML_UNUSED(policy);
+    return ggml_aligned_malloc(size);
+#endif
+}
