# Copy to .env. Never commit the real file.
LLAMA_SERVER_BIN=/path/to/llama-server
MODEL_PATH=/path/to/model.gguf
MODEL_ALIAS=local-model
CANDIDATE_HOST=127.0.0.1
CANDIDATE_PORT=18080
CTX_SIZE=32768
N_PREDICT=64
STARTUP_TIMEOUT=1800
REQUEST_TIMEOUT=7200

# Optional. The suite will not stop this unit automatically.
PRODUCTION_UNIT=
PRODUCTION_HEALTH_URL=

# Optional API key used only for benchmark requests. Keep .env untracked.
API_KEY=
